  <scm>
    <connection>scm:git:${git.url}</connection>
    <url>scm:git:${git.url}</url>
    <developerConnection>scm:git:${git.url}</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <distributionManagement>
    <site>
      <id>central</id>
      <url>${site.target.url}/</url>
    </site>
  </distributionManagement>
  <properties>
    <!-- inventory-parent (which defines this) now lives OUTSIDE the
         workspace, and Quarkus's bootstrap resolves workspace module
         versions from raw poms — so ${revision} must be resolvable here.
         -Drevision=X.Y.Z on the command line still overrides it. -->
    <revision>0.0.1-SNAPSHOT</revision>

    <iblog.version>0.13.2-SNAPSHOT</iblog.version>
    <ib.exceptions.version>66-SNAPSHOT</ib.exceptions.version>
  </properties>
